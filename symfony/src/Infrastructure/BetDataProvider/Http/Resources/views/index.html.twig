{# templates/bet_data_provider/index.html.twig #}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Estadísticas de Ligas de Fútbol</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Inter', sans-serif; }
        .league-card:hover { transform: translateY(-4px); box-shadow: 0 20px 25px -5px rgb(0 0 0 / 0.1), 0 8px 10px -6px rgb(0 0 0 / 0.1); }
    </style>
</head>
<body class="bg-gradient-to-br from-slate-50 to-slate-100 min-h-screen">
    <div class="container mx-auto px-4 py-12">
        <!-- Header -->
        <div class="text-center mb-16">
            <h1 class="text-5xl font-bold text-slate-800 mb-4">
                📊 Estadísticas de Ligas Europeas
            </h1>
            <p class="text-xl text-slate-600 max-w-2xl mx-auto">
                Analiza la forma de los últimos 5 partidos de tus equipos favoritos
            </p>
        </div>

        <!-- Grid de Ligas -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 max-w-6xl mx-auto">
            {% for code, league in leagues %}
            <a href="{{ path('league_stats', {'leagueCode': code}) }}" 
               class="league-card bg-white rounded-2xl shadow-lg overflow-hidden transition-all duration-300 border-2 border-transparent hover:border-blue-200">
                
                <!-- Cabecera de la liga -->
                <div class="bg-gradient-to-r from-blue-600 to-blue-700 px-6 py-4">
                    <div class="flex items-center justify-between">
                        <span class="text-4xl">{{ league.flag }}</span>
                        <span class="text-white font-semibold text-sm bg-white/20 px-3 py-1 rounded-full">
                            {{ league.teams_count }} equipos
                        </span>
                    </div>
                    <h2 class="text-2xl font-bold text-white mt-2">{{ league.name }}</h2>
                </div>
                
                <!-- Lista de equipos (solo algunos) -->
                <div class="p-6">
                    <h3 class="text-sm font-semibold text-slate-500 uppercase tracking-wider mb-3">
                        Equipos destacados
                    </h3>
                    <div class="space-y-2">
                        {% for teamId, teamName in league.teams|slice(0, 4) %}
                        <div class="flex items-center text-slate-700">
                            <span class="w-2 h-2 bg-blue-500 rounded-full mr-3"></span>
                            <span>{{ teamName }}</span>
                        </div>
                        {% endfor %}
                        {% if league.teams|length > 4 %}
                        <div class="text-sm text-slate-500 italic mt-2">
                            y {{ league.teams|length - 4 }} más...
                        </div>
                        {% endif %}
                    </div>
                    
                    <!-- Botón ver detalles -->
                    <div class="mt-6 flex justify-end">
                        <span class="inline-flex items-center text-blue-600 font-medium">
                            Ver estadísticas
                            <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                            </svg>
                        </span>
                    </div>
                </div>
            </a>
            {% endfor %}
        </div>

        <!-- Footer -->
        <div class="text-center mt-16 text-slate-500 text-sm">
            <p>⚽ Datos actualizados cada 3 días vía football-data.org ⚽</p>
        </div>
    </div>
</body>
</html>